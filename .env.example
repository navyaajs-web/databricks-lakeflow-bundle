# Copy to .env (git-ignored) for local `make validate` / `databricks bundle deploy`.
# Nothing in the tests reads these. Prefer `databricks auth login` (OAuth U2M)
# over tokens; if you use a token, keep it out of the repository.

DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# DATABRICKS_CONFIG_PROFILE=DEFAULT

# Optional overrides for bundle variables (BUNDLE_VAR_<name>)
# BUNDLE_VAR_catalog=workspace
# BUNDLE_VAR_warehouse_id=<sql-warehouse-id>
# BUNDLE_VAR_prod_run_as=<service-principal-application-id>
